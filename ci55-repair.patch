diff --git a/.github/workflows/deployment-smoke.yml b/.github/workflows/deployment-smoke.yml
new file mode 100644
index 0000000..a28c601
--- /dev/null
+++ b/.github/workflows/deployment-smoke.yml
@@ -0,0 +1,29 @@
+name: Test deployment smoke
+on:
+  workflow_dispatch:
+  deployment_status:
+permissions:
+  contents: read
+jobs:
+  smoke:
+    if: >-
+      (github.event_name == 'workflow_dispatch' && github.ref == 'refs/heads/test') ||
+      (github.event.deployment_status.state == 'success' &&
+       github.event.deployment_status.environment_url == 'https://fitness-test.up.railway.app')
+    runs-on: ubuntu-latest
+    timeout-minutes: 5
+    steps:
+      - uses: actions/checkout@v4
+        with:
+          ref: ${{ github.event.deployment.sha || github.sha }}
+      - uses: actions/setup-node@v4
+        with:
+          node-version: 22
+      - name: Verify test deployment and compiled assets
+        run: node server/scripts/test-deployment.mjs
+      - name: Save deployment results
+        if: always()
+        uses: actions/upload-artifact@v4
+        with:
+          name: test-deployment-results
+          path: qa/results/
