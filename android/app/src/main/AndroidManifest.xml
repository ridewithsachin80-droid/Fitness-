<?xml version="1.0" encoding="utf-8"?>
<!--
  FitLife Android wrapper (Trusted Web Activity).

  This app is a thin shell around fitness.upscale-app.com. It contains no
  business logic and no copy of the web app — the website stays the single
  source of truth, so deploying to Railway still reaches members immediately
  with no Play Store release. The shell exists for the three things a website
  cannot do: register a Google Assistant phrase, receive reliable push, and
  appear in the Play Store.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="app.upscale.fitlife">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.FitLife">

        <!-- The Trusted Web Activity itself. -->
        <activity
            android:name="com.google.androidbrowserhelper.trusted.LauncherActivity"
            android:exported="true"
            android:label="@string/app_name">

            <meta-data
                android:name="android.support.customtabs.trusted.DEFAULT_URL"
                android:value="@string/launch_url" />

            <!-- Splash. theme_color from the web manifest is #D4AF37; this must
                 match it or the launch flashes a different gold. -->
            <meta-data
                android:name="android.support.customtabs.trusted.SPLASH_IMAGE_DRAWABLE"
                android:resource="@drawable/splash" />
            <meta-data
                android:name="android.support.customtabs.trusted.SPLASH_SCREEN_BACKGROUND_COLOR"
                android:resource="@color/backgroundColor" />
            <meta-data
                android:name="android.support.customtabs.trusted.STATUS_BAR_COLOR"
                android:resource="@color/colorPrimary" />

            <!-- Assistant shortcuts live here. Declared on the MAIN/LAUNCHER
                 activity, which is where Android looks for them. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Deep links, so https://fitness.upscale-app.com opens the app
                 rather than Chrome. Requires .well-known/assetlinks.json to
                 verify — see server/index.js. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https"
                      android:host="fitness.upscale-app.com" />
            </intent-filter>
        </activity>

        <!-- Voice logging. Receives the dictated sentence from Assistant,
             posts it, speaks the reply, and finishes WITHOUT showing UI so the
             phone stays locked. -->
        <activity
            android:name=".QuickLogActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="app.upscale.fitlife.QUICK_LOG" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Receives the voice token from the web app via a deep link, so the
             member never has to copy a 64-character code by hand. -->
        <activity
            android:name=".TokenReceiverActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="fitlife" android:host="quick-log-token" />
            </intent-filter>
        </activity>
    </application>
</manifest>
